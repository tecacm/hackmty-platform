{
  "expo": {
    "name": "hackmty",
    "slug": "hackmty-platform-dev",
    "version": "1.0.0",
    "scheme": "hackmty-platform",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.hackmty",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "newArchEnabled": true,
    "experiments": {
      "reactCanary": true
    },
    "plugins": [
      "expo-image",
      "./sdk-lockdown",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false
        }
      ],
      "expo-font"
    ],
    "android": {
      "package": "com.hackmty"
    },
    "extra": {
      "eas": {
        "projectId": "f559a2c7-b69f-48cd-8a75-382a313ef1c9"
      }
    }
  }
}
